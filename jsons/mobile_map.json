{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "background": "#f8f1f1",
  "title": "Australia Mobile Network Base Stations Coverage by Operator",
  "projection": {
    "type": "mercator",
    "center": [133.7751, -25.2744],
    "scale": 800
  },
  "params": [
    {
      "name": "operator_selection",
      "bind": {
        "input": "select",
        "options": [null, "Telstra", "Optus", "TPG"],
        "labels": ["Show All", "Telstra", "Optus", "TPG"],
        "name": "Select Operator: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/SA3.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eae5e5",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/mobile_coverage_optus_telstra_tpg.csv"
      },
      "transform": [
        {
          "filter": "!operator_selection || datum.MNO == operator_selection"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 25,
        "opacity": 0.65
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "color": {
          "field": "MNO",
          "type": "nominal",
          "title": "Operator",
          "scale": {
            "domain": ["Telstra", "Optus", "TPG"],
            "range": ["#002b49", "#da291c", "#6b2d5c"]
          }
        },
        "tooltip": [
          {"field": "RFNSA ID", "type": "nominal", "title": "RFNSA ID"},
          {"field": "MNO", "type": "nominal", "title": "Operator"},
          {"field": "Year", "type": "quantitative", "title": "Installation Year"},
          {"field": "LTE700", "type": "nominal", "title": "LTE 700"},
          {"field": "NR3500", "type": "nominal", "title": "NR 3500 (5G)"}
        ]
      }
    }
  ]
}
