{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 600,
  "title": "Mobile Network Base Stations Coverage",
  "projection": {
    "type": "mercator",
    "center": [133.7751, -25.2744],
    "scale": 1000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vega/vega/main/docs/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e0e0e0", "stroke": "white"}
    },
    {
      "data": {
        "url": "data/mobile_coverage_optus_telstra_tpg.csv"
      },
      "mark": {"type": "circle", "size": 30, "opacity": 0.7},
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "color": {
          "field": "MNO",
          "type": "nominal",
          "title": "Operator",
          "scale": {
            "domain": ["Telstra", "Optus", "TPG"],
            "range": ["#002b49", "#da291c", "#6b2d5c"]
          }
        },
        "tooltip": [
          {"field": "RFNSA ID", "type": "nominal", "title": "RFNSA ID"},
          {"field": "MNO", "type": "nominal", "title": "Operator"},
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {"field": "LTE700", "type": "nominal", "title": "LTE 700"},
          {"field": "NR3500", "type": "nominal", "title": "NR 3500 (5G)"}
        ]
      }
    }
  ]
}