{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Average daily outages by state or territory (Lollipop Chart).",
  "data": {"url": "../data/Measuring Broadband.csv"},
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2, "color": "#cbd5e1"},
      "encoding": {
        "x": {"field": "state_or_territory", "type": "nominal", "title": "State / Territory"},
        "y": {"aggregate": "mean", "field": "Average daily outages", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "circle", "size": 100},
      "encoding": {
        "x": {"field": "state_or_territory", "type": "nominal", "title": "State / Territory"},
        "y": {"aggregate": "mean", "field": "Average daily outages", "type": "quantitative", "title": "Mean Daily Outages"},
        "color": {"field": "state_or_territory", "type": "nominal", "legend": null},
        "tooltip": [
          {"field": "state_or_territory", "type": "nominal", "title": "State"},
          {"aggregate": "mean", "field": "Average daily outages", "type": "quantitative", "title": "Mean Outages"}
        ]
      }
    }
  ],
  "width": 800,
  "height": 300
}