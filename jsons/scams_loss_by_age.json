{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Scam reports and financial loss correlation by age group (Advanced Bubble Chart).",
  "data": {"url": "data/scams_summary_by_state.csv"},
  "transform": [
    {"calculate": "toNumber(replace(datum.Amount_lost, '$', ''))", "as": "Clean_Amount"},
    {"filter": "isValid(datum.Complainant_Age) && datum.Complainant_Age !== null && datum.Complainant_Age !== ''"}
  ],
  "width": 800,
  "height": 300,
  "encoding": {
    "x": {"field": "Complainant_Age", "type": "nominal", "title": "Complainant Age Group"},
    "y": {"aggregate": "sum", "field": "Clean_Amount", "type": "quantitative", "title": "Total Amount Lost ($)"}
  },
  "layer": [
    {
      "mark": {"type": "circle", "opacity": 0.8, "stroke": "black", "strokeWidth": 0.5},
      "encoding": {
        "size": {
          "aggregate": "sum", 
          "field": "Number_of_reports", 
          "type": "quantitative", 
          "title": "Total Reports", 
          "legend": null
        },
        "color": {
          "field": "Complainant_Age", 
          "type": "nominal", 
          "title": "Age Group"
        },
        "tooltip": [
          {"field": "Complainant_Age", "type": "nominal", "title": "Age Group"},
          {"aggregate": "sum", "field": "Number_of_reports", "type": "quantitative", "title": "Reports Count"},
          {"aggregate": "sum", "field": "Clean_Amount", "type": "quantitative", "title": "Total Lost ($)", "format": "$,.2f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "dy": -15, "fontSize": 11, "fontWeight": "bold"},
      "encoding": {
        "text": {
          "aggregate": "sum",
          "field": "Clean_Amount",
          "type": "quantitative",
          "format": "$,.0f"
        }
      }
    }
  ]
}