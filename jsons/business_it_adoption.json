{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Business Use of IT Trend over Time by Top 9 Countries and AUS.",
  "data": {"url": "data/Business_Use_of_Information_Technology.csv"},
  "transform": [
    {
      "joinaggregate": [{"op": "mean", "field": "OBS_VALUE", "as": "mean_value"}],
      "groupby": ["REF_AREA"]
    },
    {
      "window": [{"op": "dense_rank", "as": "rank"}],
      "sort": [{"field": "mean_value", "order": "descending"}]
    },
    {
      "filter": "datum.rank <= 9 || datum.REF_AREA == 'AUS'"
    }
  ],
  "mark": {"type": "line", "point": true},
  "encoding": {
    "x": {"field": "TIME_PERIOD", "type": "nominal", "title": "Year"},
    "y": {
      "field": "OBS_VALUE",
      "type": "quantitative",
      "title": "Percentage (%)",
      "scale": {"domainMin": 70}
    },
    "color": {"field": "REF_AREA", "type": "nominal", "title": "Country"},
    "tooltip": [
      {"field": "REF_AREA", "type": "nominal", "title": "Country"},
      {"field": "TIME_PERIOD", "type": "nominal", "title": "Year"},
      {"field": "OBS_VALUE", "type": "quantitative", "title": "Percentage (%)"}
    ]
  },
  "width": 700,
  "height": 350
}