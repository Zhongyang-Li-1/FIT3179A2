{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "background": "#f8f1f1",
  "projection": {
    "type": "mercator",
    "center": [133.7751, -25.2744],
    "scale": 800
  },
  "layer": [
    {
      "data": {
        "url": "data/SA3.json", 
        "format": {"type": "json", "property": "features"} 
     
