      }
    },
    {
      "data": {
        "url": "data/nbn_coverage_fixedline.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "",     
        "fillOpacity": 0.6,     
        "stroke": "#d81d1d",
        "strokeWidth": 0.2
      }
    }
  ]
}