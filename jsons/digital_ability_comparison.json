{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Advanced Lollipop Chart for Digital Ability Comparison - Top 9",
  "data": {"url": "data/Digital_Ability_comparison.csv"},
  "transform": [
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "Score", "order": "descending"}]
    },
    {
      "filter": "datum.rank <= 9"
    }
  ],
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2, "color": "#cbd5e1"},
      "encoding": {
        "y": {"field": "Subgroup", "type": "nominal", "sort": "-x", "title": "Subgroup"},
        "x": {"field": "Score", "type": "quantitative"},
        "x2": {"value": 0}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 120},
      "encoding": {
        "y": {"field": "Subgroup", "type": "nominal", "sort": "-x"},
        "x": {"field": "Score", "type": "quantitative", "title": "Score"},
        "color": {"field": "Subgroup", "type": "nominal", "legend": null}
      }
    }
  ],
  "width": 700,
  "height": 280
}